NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=file:./dev.db
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long


# Email verification: trusted HTTPS webhook that sends the 10-digit code to the recipient.
EMAIL_VERIFICATION_WEBHOOK_URL=
EMAIL_VERIFICATION_WEBHOOK_TOKEN=

# Shared distributed rate limiting (required in production; optional in local development).
# Use an Upstash Redis REST database and keep the token in the deployment secret manager.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=

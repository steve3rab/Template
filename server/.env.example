NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=file:./dev.db
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Email verification: POST a JSON payload { type, to, subject, code, expiresAt, expiresInMinutes }
# to this HTTPS endpoint. Configure a trusted mail delivery webhook in production.
EMAIL_VERIFICATION_WEBHOOK_URL=
EMAIL_VERIFICATION_WEBHOOK_TOKEN=

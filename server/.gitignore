# Backend build output and generated artifacts
/dist/
/build/
/coverage/
/.cache/
/.tmp/
/tmp/
/logs/

# Runtime uploads and local storage (not source-controlled)
/uploads/
/storage/

# Backend environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Prisma generated client and local database files
/prisma/generated/
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal
/prisma/*.sqlite
/prisma/*.sqlite3

# Logs and temporary files
*.log
*.pid
*.pid.lock
*.tmp
*.temp

# OS/editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

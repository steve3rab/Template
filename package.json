{
  "name": "template-react",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "server"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --workspace @template/api run dev",
    "dev:all": "concurrently -k -n API,WEB -c blue,green \"npm run dev:server\" \"npm run dev -- --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "build:server": "npm --workspace @template/api run build",
    "typecheck": "tsc -b --pretty && npm --workspace @template/api run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run server/src",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed:test-users": "tsx server/scripts/seed-test-users.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage:ci && npm run build && npm run build:server",
    "test:coverage:server": "vitest run --coverage --coverage.include='server/src/**/*.ts' --coverage.exclude='server/src/index.ts' --coverage.reportsDirectory=coverage/server",
    "test:coverage:ci": "npm run test:coverage && npm run test:coverage:server"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.13.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
